# Copy to .env and fill in. Never commit .env.

# LLM provider used by the orchestration layer.
BIOFLOW_LLM_PROVIDER=anthropic
# Model identifier passed to the provider.
BIOFLOW_LLM_MODEL=
# API key for the Anthropic provider.
ANTHROPIC_API_KEY=
# Optional NCBI E-utilities key; raises the public rate limit.
NCBI_API_KEY=
# Root directory for cached reference and downloaded data.
BIOFLOW_DATA_DIR=
# Root directory for per-run working directories and provenance.
BIOFLOW_RUN_DIR=
