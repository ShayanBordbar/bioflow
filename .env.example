# Copy to .env and fill in. Never commit .env.
# Every BioFlow setting is overridable here with the BIOFLOW_ prefix; the values
# shown are the defaults, so an empty .env is a working configuration.

# --- LLM ---------------------------------------------------------------------
# LLM provider: "anthropic" or "openai-compatible". The latter is one client for
# every server speaking /v1/chat/completions -- vLLM, Ollama, llama.cpp, TGI, and
# hosted gateways -- so what distinguishes them is only BIOFLOW_LLM_BASE_URL.
# Familiar names (ollama, vllm, openai, local, ...) are accepted as aliases.
# Anything else is rejected at client construction, never silently ignored.
BIOFLOW_LLM_PROVIDER=anthropic

# Required for openai-compatible; rejected for anthropic, whose endpoint is fixed.
#   Ollama:  http://localhost:11434/v1
#   vLLM:    http://localhost:8000/v1
BIOFLOW_LLM_BASE_URL=

# Optional. Local servers usually need no credential, and an unset key means no
# Authorization header at all rather than a failure. Falls back to OPENAI_API_KEY.
BIOFLOW_LLM_API_KEY=

# Optional, for a paid OpenAI-compatible gateway. Left unset, a self-hosted model
# is recorded as genuinely free (cost 0.00, not "unknown").
BIOFLOW_LLM_INPUT_PRICE_PER_MTOK=
BIOFLOW_LLM_OUTPUT_PRICE_PER_MTOK=

# Hosts to treat as inside your perimeter under BIOFLOW_OFFLINE, beyond loopback
# and private IP ranges, which are recognized automatically. Needed when a cluster
# addresses nodes by bare name -- the guard cannot classify "gpu-01" from the name
# alone, so it fails closed and you widen it here on purpose. Exact names, or a
# suffix written ".hpc.example.edu". Comma-separated or a JSON list.
#   BIOFLOW_LLM_LOCAL_HOSTS=gpu-01,gpu-02,.hpc.example.edu
BIOFLOW_LLM_LOCAL_HOSTS=
# Model identifier passed to the provider.
BIOFLOW_LLM_MODEL=claude-opus-5
# Sampling temperature. Kept at 0 so runs are reproducible.
BIOFLOW_LLM_TEMPERATURE=0.0
# How many times a malformed tool call may be handed back for repair.
BIOFLOW_LLM_MAX_REPAIR_ATTEMPTS=2

# API key for the Anthropic provider. Not required if you have authenticated
# with `ant auth login`, or set ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_API_KEY=
# Optional NCBI E-utilities key; raises the public rate limit.
NCBI_API_KEY=

# --- Locations ---------------------------------------------------------------
# Root directory for cached reference and downloaded data. Defaults to the
# platform data directory. run_dir and store_dir follow it unless set here.
BIOFLOW_DATA_DIR=
# Root directory for per-run working directories and provenance.
BIOFLOW_RUN_DIR=
# Root directory for the content-addressed object store.
BIOFLOW_STORE_DIR=

# --- Agent loop --------------------------------------------------------------
# Hard caps on the orchestration loop. Exceeding any of them ends the run in
# FAILED with a RESOURCE_LIMIT error naming which cap was hit.
# Total state transitions one run may take.
BIOFLOW_AGENT_MAX_STEPS=25
# Tool calls one state may make before giving up on it.
BIOFLOW_AGENT_MAX_TOOL_CALLS_PER_STATE=8
# How much context one LLM call may carry, in estimated tokens (~4 chars each).
# The floor -- system prompt, state objective, tool schemas, request, and any
# correction -- is never truncated; if it alone exceeds this, the run fails with
# RESOURCE_LIMIT rather than sending an oversized request. Everything else is
# truncated with an explicit [truncated: N of M] marker.
BIOFLOW_AGENT_TOKEN_BUDGET=12000
# Turns kept verbatim. Older ones fold into one line each.
BIOFLOW_AGENT_CONTEXT_WINDOW_TURNS=4
# There is no separate agent wall clock: MAX_RUNTIME_MINUTES below is the run's
# time budget, and the agent loop is part of the run.

# --- Budgets and guardrails --------------------------------------------------
# Refuse a download larger than this.
BIOFLOW_MAX_DOWNLOAD_GB=20.0
# Refuse a run longer than this. Also caps the agent loop's wall clock.
BIOFLOW_MAX_RUNTIME_MINUTES=120
# Tools at or above this cost class need explicit confirmation.
# One of FREE, CHEAP, MODERATE, EXPENSIVE.
BIOFLOW_REQUIRE_CONFIRMATION_ABOVE=MODERATE
# Hosts downloads are permitted to reach. Comma-separated or a JSON list.
BIOFLOW_ALLOWED_DOWNLOAD_DOMAINS=ncbi.nlm.nih.gov,eutils.ncbi.nlm.nih.gov,ftp.sra.ebi.ac.uk,www.ebi.ac.uk,huggingface.co,cdn-lfs.huggingface.co

# --- Execution ---------------------------------------------------------------
# Where heavy runtimes execute: local or docker.
BIOFLOW_SIDECAR_MODE=local
# The sequence sidecar's container image, required for sidecar_mode=docker. Must be
# pinned by digest -- a moving tag makes a recorded run unreproducible in the quietest
# possible way, and the runner refuses one.
# BIOFLOW_SIDECAR_IMAGE=bioflow/sequence-sidecar@sha256:0000...
# Wall clock for one sidecar job. On expiry the whole process group is killed, so a
# forked GPU worker cannot outlive the job that started it.
BIOFLOW_SIDECAR_TIMEOUT_SECONDS=3600
# No egress. Refuses any hosted LLM call and skips the doctor's reachability
# check, but still permits an openai-compatible endpoint on loopback or a private
# network -- which is what makes air-gapped operation possible.
BIOFLOW_OFFLINE=false
# LLM cassette handling: off, record, or replay.
BIOFLOW_CASSETTE_MODE=off
