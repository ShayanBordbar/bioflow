{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A content-addressed handle to something a tool produced.\n\n``produced_by`` follows the convention ``name@version`` (for example\n``kallisto@0.50.1``). It is documented rather than pattern-enforced because\nupstream tools report version strings in whatever shape they like.",
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "produced_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Produced By"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^run_[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "uri",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "description": "The closed set of artifact shapes BioFlow knows how to move around.",
      "enum": [
        "fasta",
        "fastq",
        "tsv",
        "csv",
        "json",
        "yaml",
        "html",
        "parquet",
        "checkpoint",
        "log",
        "directory",
        "other"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "One unit of work handed to a heavy runtime.\n\n``seed`` is separate from ``params`` rather than buried in it because determinism is\na property of the whole job, and a caller reproducing a run needs to find it without\nknowing the op's parameter names.",
  "properties": {
    "contract_version": {
      "const": "1",
      "default": "1",
      "title": "Contract Version",
      "type": "string"
    },
    "inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "op": {
      "minLength": 1,
      "title": "Op",
      "type": "string"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/JSONValue"
      },
      "title": "Params",
      "type": "object"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    }
  },
  "required": [
    "op"
  ],
  "title": "SidecarJob",
  "type": "object"
}
